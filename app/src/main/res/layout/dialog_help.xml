<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="20dp">

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="32dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/dialog_help_title"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/help_close"
            android:layout_width="25dp"
            android:layout_height="match_parent"
            android:clickable="true"
            android:text="\u2716"
            android:layout_alignParentRight="true" />

    </RelativeLayout>


    <Space
        android:layout_width="match_parent"
        android:layout_height="20dp" />

    <TextView
        android:id="@+id/help_item1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dialog_help_txta"
        android:textSize="16sp"
        android:paddingVertical="12dp"
        android:clickable="true"
        android:background="?attr/selectableItemBackground" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0" />

    <TextView
        android:id="@+id/help_item2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dialog_help_txtb"
        android:textSize="16sp"
        android:paddingVertical="12dp"
        android:clickable="true"
        android:background="?attr/selectableItemBackground" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="20dp" />

    <TextView
        android:id="@+id/help_cancel"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/dialog_help_cancel"
        android:textSize="16sp"
        android:textColor="#2196F3"
        android:gravity="center"
        android:clickable="true"
        android:background="?attr/selectableItemBackground" />

</LinearLayout>